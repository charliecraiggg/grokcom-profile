<view class="shell" wx:if="{{work}}"><view class="kicker">{{work.format}}</view><view class="heading">{{work.title}}</view><view class="meta">{{work.subtitle}}</view><video wx:if="{{video && !failed}}" class="video" src="{{video}}" poster="{{work.poster}}" controls object-fit="contain" binderror="onVideoError"/><block wx:else><image class="cover" src="{{work.poster}}" mode="widthFix" aria-label="{{work.title}}封面"/><view class="muted status">{{failed ? '暂时无法播放，请稍后再试。' : '体验版可查看作品封面，原画视频待接入。'}}</view></block><button class="action" open-type="share">分享这部作品</button></view><view class="shell" wx:else><view class="heading">找不到这部作品</view><navigator class="muted" open-type="reLaunch" url="/pages/index/index">返回作品集</navigator></view>